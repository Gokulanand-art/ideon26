# =============================================================================
# Hackathon Registration — environment variables
# Copy this file to `.env.local` and fill in the values you need.
# NEVER commit real credentials. `.env.local` is gitignored.
# =============================================================================

# --- Event configuration (display + capacity defaults) ---
EVENT_NAME="Hackathon 2026"
EVENT_TAGLINE="Build. Create. Innovate."
EVENT_DATE="TBA"
EVENT_END_DATE=""
EVENT_VENUE="TBA"
EVENT_DURATION="24 hours"
EVENT_PRIZE="Cash prizes, swag & internship opportunities"
EVENT_DESCRIPTION="A high-energy offline hackathon for builders, creators and problem solvers. Form a team of up to 4, pay your entry fee by UPI, and build something extraordinary at the venue."

# Capacities (also seeded into the database `settings` table).
# The database settings table is the single source of truth used by the
# capacity trigger and the stats API, so changing these requires re-running
# `npm run db:setup` (or updating the settings table directly).
ONLINE_CAPACITY=20
ONSITE_CAPACITY=10
TOTAL_CAPACITY=30
REGISTRATION_OPEN=true

# On-spot (walk-in) registration channel. Independent of REGISTRATION_OPEN:
# a channel can have seats remaining yet stay closed. Defaults to closed —
# only ONLINE registration is available unless you enable this.
ONSITE_REGISTRATION_OPEN=false

# --- Fees & UPI payments ---------------------------------------------------
# Entry fee per head (₹). Team total = team_size × FEE_PER_HEAD, calculated
# automatically on the registration form.
FEE_PER_HEAD=150

# UPI details shown on the payment page (Pay button / QR code).
UPI_ID="7449007050@ybl"
PAYEE_NAME="HACKATHON"

# Registration ID prefix (e.g. HK26-0001)
REG_ID_PREFIX="HK26"

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite PostgreSQL engine
# (zero-config, persisted under ./data). Set it to connect to a real Postgres
# or Supabase pooler, e.g.:
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/hackathon"
#   DATABASE_URL="postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# REQUIRED for serverless deployments (e.g. Vercel): the embedded engine keeps
# data on the local filesystem only, so use DATABASE_URL there.
DATABASE_URL=""

# Directory used by the embedded PGlite engine (only when DATABASE_URL is empty).
PGLITE_DATA_DIR="./data/hackathon"

# --- Admin authentication -------------------------------------------------
# Username for the admin dashboard.
ADMIN_USERNAME="admin"

# Set ONE of the following for the admin password:
#  - ADMIN_PASSWORD_HASH (recommended): scrypt hash from `npm run hash-password`
#  - ADMIN_PASSWORD (convenience): plaintext, hashed at runtime for comparison
ADMIN_PASSWORD_HASH=""
ADMIN_PASSWORD=""

# Secret used to sign admin session cookies and registration access tokens.
# Generate one with:  openssl rand -hex 32
ADMIN_AUTH_SECRET=""

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# --- Deployment -----------------------------------------------------------
# Public site URL (used for Open Graph / SEO).
PUBLIC_URL="http://localhost:3000"